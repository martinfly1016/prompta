# Copy to .env.local and fill in real values. Do not commit .env, .env.local,
# .env.development, or .env.production.
#
# `npm run build` fills non-secret defaults for DATABASE_URL, NEXTAUTH_SECRET,
# and NEXTAUTH_URL when they are unset, so Prisma generate and next build do
# not need a committed env file. Set the real values in the Vercel project
# environment (and in CI). Those override the defaults.

# Database — placeholder shape only. Any Postgres URL works for `prisma generate`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Vercel Blob read/write token (Vercel Dashboard → Storage → Blob).
# Never commit the real token.
BLOB_READ_WRITE_TOKEN=

# Admin account used by `npm run db:seed`.
# Change this before seeding any shared database. Do not leave "changeme" in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
