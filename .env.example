# Database
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin Account (for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Stripe (test mode locally — never put sk_live here)
# Checkout uses inline price_data from src/lib/credit-costs.ts.
# STRIPE_PRICE_ID is unused. The old dashboard Price named 「10回パック」 must not be wired back in.
# The card statement / account display name ("bytead") is set in the Stripe dashboard, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ignored. New sign-ins always receive WELCOME_POINTS (3) from src/lib/credit-costs.ts.
# Existing wallets are not rewritten.
WELCOME_BONUS_CREDITS=

# Magic-link sender. The From address is this inbox (AgentMail has no separate From header).
# Set a verified address such as noreply@prompta.jp, and set the inbox display name to "prompta.jp" in the AgentMail dashboard.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# gpt-image-1 quality. Only "low" is passed through. Anything else, including "high", is sent as "medium".
OPENAI_IMAGE_QUALITY=medium
