# Database
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin Account (for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Stripe (test mode locally — never put sk_live here)
# Checkout uses inline price_data from src/lib/credit-costs.ts.
# STRIPE_PRICE_ID is unused. The old dashboard Price named 「10回パック」 must not be wired back in.
# The card statement / account display name ("bytead") is set in the Stripe dashboard, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ignored. New sign-ins always receive WELCOME_POINTS (3) from src/lib/credit-costs.ts.
# Existing wallets are not rewritten.
WELCOME_BONUS_CREDITS=

# Transactional email (magic link, purchase mail, daily report).
# Resend is primary. AgentMail is used only when RESEND_API_KEY is empty.
RESEND_API_KEY=
EMAIL_FROM=Prompta <noreply@mail.prompta.jp>

# Public contact address on /legal/privacy, /legal/terms, and /legal/tokushoho.
# Defaults to prompta.jp@gmail.com (SITE_CONFIG.email). Not the transactional From.
CONTACT_EMAIL=

# Optional AgentMail fallback. The From address is the inbox id (no display name).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Paid image models. Defaults are the efficient current tiers (1 credit / run).
# Gemini uses the Interactions API. Legacy ids (gemini-2.5-flash-image and the
# shut-down *-preview image models) stay on generateContent for rollback.
GEMINI_PAID_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_MODEL is used only when GEMINI_PAID_IMAGE_MODEL is unset.
# Text-to-image size for Nano Banana 2.1: 1K (default), 2K, or 4K.
# 512 is rejected (that size is Gemini 3.1 Flash Image only).
# Edits match the source photo unless the caller sets an aspect ratio.
# GEMINI_IMAGE_SIZE=1K
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Optional. Reference-photo edits use this when set, otherwise OPENAI_IMAGE_MODEL.
# OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
# Only "low" is passed through. Anything else, including "high" / "auto", is sent as "medium".
OPENAI_IMAGE_QUALITY=medium
