{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {
    "SKIP_ENV_VALIDATION": "true"
  },
  "functions": {
    "src/app/**/*.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "prompta.jp"
        }
      ],
      "destination": "https://www.prompta.jp/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.prompta.jp"
        },
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.prompta.jp/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_next/static/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/auth/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/admin/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/checkout/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/webhooks/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/cron/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/upload/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/debug/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/test/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/tools/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/prompt/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/revalidate",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/health",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/prompts/:id/view",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/api/prompts/:id/copy",
      "headers": [{ "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate" }]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 0 * * *"
    }
  ]
}
